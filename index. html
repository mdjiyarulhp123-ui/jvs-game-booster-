
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>JVS GAME BOOSTER</title>
<style>
body{margin:0;background:#080d0a;color:white;font-family:Arial;padding:16px}
h1,h2{color:#39ff75}
.card{background:#142019;padding:16px;border-radius:12px;margin:14px 0}
button,a{background:#39ff75;color:#071009;padding:10px;border:0;border-radius:7px;font-weight:bold;text-decoration:none}
input{display:block;width:95%;padding:10px;margin:10px 0;background:#080d0a;color:white;border:1px solid #39ff75}
.game{padding:12px;background:#080d0a;margin:10px 0;border-radius:8px}
label{display:block;padding:10px 0}
</style>
</head>
<body>
<h1>⚡ JVS GAME BOOSTER</h1>
<p>Welcome Gamer! 🎮</p>

<div class="card">
<h2>🎮 Game Zone</h2>
<div class="game">Free Fire MAX<br><br>
<a href="https://play.google.com/store/search?q=Free%20Fire%20MAX&c=apps">OPEN GAME</a></div>
<div class="game">Subway Surfers<br><br>
<a href="https://play.google.com/store/search?q=Subway%20Surfers&c=apps">OPEN GAME</a></div>
</div>

<div class="card">
<h2>➕ Add Game Link</h2>
<input id="name" placeholder="Game ka naam">
<input id="url" placeholder="https:// game link">
<button onclick="addGame()">ADD GAME</button>
<div id="mygames"></div>
</div>

<div class="card">
<h2>🚀 Game Booster Checklist</h2>
<label><input type="checkbox"> Background apps check karo</label>
<label><input type="checkbox"> Graphics Smooth par rakho</label>
<label><input type="checkbox"> Downloads pause karo</label>
<label><input type="checkbox"> Phone thanda rakho</label>
<button onclick="alert('Gaming checklist check kar lo!')">READY TO PLAY</button>
</div>

<div class="card">
<h2>💡 Lag Fix Tips</h2>
<p>✔ Free Fire MAX ki graphics Smooth karo.</p>
<p>✔ Bade downloads rok do.</p>
<p>✔ Phone garam ho to break lo.</p>
<p>✔ Stable internet use karo.</p>
</div>

<script>
function addGame(){
 var n=document.getElementById('name').value.trim();
 var u=document.getElementById('url').value.trim();
 if(!n||!u){alert('Game name aur link bharo');return;}
 try{
  var link=new URL(u);
  if(link.protocol!=='https:'){
   alert('HTTPS link use karo');return;
  }
  var a=document.createElement('a');
  a.href=link.href;
  a.target='_blank';
  a.rel='noopener noreferrer';
  a.textContent='OPEN GAME';
  var d=document.createElement('div');
  d.className='game';
  d.appendChild(document.createTextNode(n+' '));
  d.appendChild(a);
  document.getElementById('mygames').appendChild(d);
  document.getElementById('name').value='';
  document.getElementById('url').value='';
 }catch(e){alert('Sahi HTTPS link dalo');}
}
</script>
</body>
</html>
