
<!DOCTYPE html>
<html lang="hi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#07100b">
<title>JVS GAME BOOSTER</title>
<style>
:root{--bg:#07100b;--panel:#101b14;--green:#39ff75;--muted:#aab9ae}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:#fff;font-family:Arial,sans-serif}
header{padding:22px 16px;text-align:center;background:#0d1c12;border-bottom:1px solid #254a30}
.logo{font-size:26px;font-weight:900;color:var(--green)}
header p{color:var(--muted);font-size:13px}
main{max-width:750px;margin:auto;padding:15px}
h2{font-size:19px}
.panel{background:var(--panel);border:1px solid #254631;border-radius:15px;padding:16px;margin:14px 0}
.hero{background:linear-gradient(140deg,#143b20,#101b14);text-align:center}
.hero h1{color:var(--green);font-size:25px}
button,.linkbtn{border:0;border-radius:9px;padding:12px 14px;background:var(--green);color:#06100a;font-weight:bold;cursor:pointer;text-decoration:none;display:inline-block}
input{width:100%;padding:12px;margin:6px 0 12px;background:#07100b;border:1px solid #36533d;color:white;border-radius:8px}
.game{display:flex;align-items:center;justify-content:space-between;gap:10px;background:#0a130d;border:1px solid #243d2a;border-radius:10px;padding:12px;margin:9px 0}
.game strong{display:block;margin-bottom:5px}
.small{font-size:12px;color:var(--muted)}
.check{display:flex;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid #24352a}
.check input{width:20px;height:20px;margin:0;accent-color:var(--green)}
#progress{color:var(--green);font-weight:bold}
.note{font-size:13px;color:var(--muted);line-height:1.6}
footer{text-align:center;color:var(--muted);font-size:12px;padding:25px}
</style>
</head>
<body>
<header>
  <div class="logo">⚡ JVS GAME BOOSTER</div>
  <p>GAME • PLAY • IMPROVE</p>
</header>

<main>
<section class="panel hero">
  <h1>BOOST YOUR GAMING!</h1>
  <p>Apni gaming ke liye taiyar ho?</p>
  <a class="linkbtn" href="#booster">START CHECKLIST</a>
  <p class="small">Free website • Mobile friendly</p>
</section>

<section class="panel">
  <h2>🎮 Game Zone</h2>
  <p class="note">Official store par game search karne ke liye button dabao.</p>
  <div id="games"></div>
</section>

<section class="panel">
  <h2>➕ Apna Game Link Jodo</h2>
  <label for="gameName">Game ka naam</label>
  <input id="gameName" maxlength="50" placeholder="Jaise: My Favourite Game">
  <label for="gameUrl">Official game ya store link (https://)</label>
  <input id="gameUrl" type="url" placeholder="https://..." inputmode="url">
  <button id="addGame">+ Add Game</button>
  <p class="small">Sirf bharosemand official links jodo.</p>
</section>

<section class="panel" id="booster">
  <h2>🚀 Gaming Preparation</h2>
  <p class="note">Har kaam karne ke baad check karo.</p>
  <div class="check"><input type="checkbox" class="task"><span>Background mein chal rahe gair-zaroori apps band kiye</span></div>
  <div class="check"><input type="checkbox" class="task"><span>Game ki graphics Smooth/Low par rakhi</span></div>
  <div class="check"><input type="checkbox" class="task"><span>Downloads aur updates check kiye</span></div>
  <div class="check"><input type="checkbox" class="task"><span>Phone ko thanda rakha aur battery check ki</span></div>
  <p id="progress">0 / 4 complete</p>
  <button id="reset">Reset Checklist</button>
</section>

<section class="panel">
  <h2>💡 Lag Kam Karne Ke Tips</h2>
  <ul class="note">
    <li>Free Fire MAX ki graphics Smooth par try karo.</li>
    <li>Game khelte waqt bade downloads rok do.</li>
    <li>Phone garam ho to break lekar thanda hone do.</li>
    <li>Network slow ho to Wi-Fi aur mobile data ki stability check karo.</li>
    <li>Storage mein kuch khaali jagah rakho aur game update rakho.</li>
    <li>Unknown booster APK ya modded game install mat karo.</li>
  </ul>
</section>

<p class="note">Zaroori baat: Yeh website checklist aur game links deti hai. Yeh khud RAM saaf nahi karti aur na hi FPS badhane ki guarantee deti hai.</p>
</main>

<footer>© 2026 JVS GAME BOOSTER<br>Made for gamers 💚</footer>

<script>
const defaultGames = [
 {name:"Free Fire MAX",url:"https://play.google.com/store/search?q=Free%20Fire%20MAX&c=apps"},
 {name:"Subway Surfers",url:"https://play.google.com/store/search?q=Subway%20Surfers&c=apps"},
 {name:"Asphalt 8",url:"https://play.google.com/store/search?q=Asphalt%208&c=apps"}
];

function getGames(){
 try {
   const saved=JSON.parse(localStorage.getItem("jvsGames")||"[]");
   return [...defaultGames,...saved];
 } catch(e) { return defaultGames.slice(); }
}

function renderGames(){
 const list=document.getElementById("games");
 list.textContent="";
 getGames().forEach(game=>{
   const row=document.createElement("div");
   row.className="game";
   const info=document.createElement("div");
   const name=document.createElement("strong");
   name.textContent="🎮 "+game.name;
   const sub=document.createElement("span");
   sub.className="small";
   sub.textContent="Game link";
   info.append(name,sub);
   const link=document.createElement("a");
   link.className="linkbtn";
   link.href=game.url;
   link.target="_blank";
   link.rel="noopener noreferrer";
   link.textContent="OPEN";
   row.append(info,link);
   list.append(row);
 });
}

document.getElementById("addGame").addEventListener("click",()=>{
 const name=document.getElementById("gameName").value.trim();
 const rawUrl=document.getElementById("gameUrl").value.trim();
 if(!name || !rawUrl){alert("Game ka naam aur link dono bharo.");return;}
 let url;
 try { url=new URL(rawUrl); } catch(e) {
   alert("Sahi link dalo, jaise https://example.com");return;
 }
 if(url.protocol!=="https:"){
   alert("Safety ke liye sirf HTTPS links allowed hain.");return;
 }
 try {
   const saved=JSON.parse(localStorage.getItem("jvsGames")||"[]");
   saved.push({name:name,url:url.href});
   localStorage.setItem("jvsGames",JSON.stringify(saved));
   document.getElementById("gameName").value="";
   document.getElementById("gameUrl").value="";
   renderGames();
   alert("Game link add ho gaya!");
 } catch(e) {
   alert("Link save nahi ho saka. Browser storage check karo.");
 }
});

function updateProgress(){
 const tasks=[...document.querySelectorAll(".task")];
 const done=tasks.filter(t=>t.checked).length;
 document.getElementById("progress").textContent=done+" / "+tasks.length+" complete";
}
document.querySelectorAll(".task").forEach(t=>t.addEventListener("change",updateProgress));
document.getElementById("reset").addEventListener("click",()=>{
 document.querySelectorAll(".task").forEach(t=>t.checked=false);
 updateProgress();
});
renderGames();
</script>
</body>
</html>
